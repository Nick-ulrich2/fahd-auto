# Copiez ce fichier en « .env » (local) ou définissez ces variables chez votre hébergeur (Vercel / Netlify).

# Adresse publique du site, sans « / » final. INDISPENSABLE pour Google (sitemap, adresses canoniques, liens dans les messages).
VITE_SITE_URL=https://www.votre-domaine.com

# Mesure d'audience (facultatif, l'une ou l'autre)
# Plausible : sans cookie, aucun bandeau. Indiquez le domaine déclaré chez Plausible.
VITE_PLAUSIBLE_DOMAIN=
# Google Analytics 4 : un bandeau de consentement s'affiche automatiquement.
VITE_GA_ID=

# Feuille Google Sheets publiée en CSV pour changer prix et statuts (réservé / vendu) sans toucher au code.
VITE_STOCK_SHEET_CSV=
